rules_version = '2';

// =============================================================================
// 進度本 Storage 安全規則
//
// 階段一步驟 1 佔位版本：一律拒絕。步驟 3 實作完整規則，需滿足：
//   1. 讀取：該群組成員
//   2. 寫入：該群組管理者（admin / owner）
//   3. 單檔上限 30 MB
//   4. 拒絕 video/*
// 上述四項各自都要有對應的拒絕測試案例。
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
