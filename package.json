{
  "name": "jindu",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "pnpm -r --no-bail test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @jindu/web dev",
    "emu": "firebase emulators:start --import ./.emulator-data --export-on-exit ./.emulator-data",
    "emu:clean": "firebase emulators:start"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs",
      "@firebase/util"
    ]
  }
}
