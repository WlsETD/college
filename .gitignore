node_modules/
dist/
coverage/

# Functions 的打包產物。只鎖這一個路徑——寫成 lib/ 會連
# apps/web/src/lib/ 與 functions/src/lib/ 的原始碼一起排除掉。
/functions/lib/

# 部署專用的獨立目錄（含真的 npm install 出來的 node_modules），
# 只有 pnpm --filter @jindu/functions run build:deploy 會產生，見該指令的說明。
/functions/.deploy/

# 字型子集化的來源檔快取，由 scripts/build-fonts.mjs 自動下載
apps/web/.font-cache/
.DS_Store

# 環境變數：只有 .env.example 進版控
.env
.env.*
!.env.example

# Firebase
.firebase/
.emulator-data/
firebase-debug.log
firestore-debug.log
ui-debug.log
*-debug.log

# 憑證：一律不得進版控
*serviceAccount*.json
*.pem
*.key
