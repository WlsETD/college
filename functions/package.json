{
  "name": "@jindu/functions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:deploy": "node esbuild.config.mjs && node prepare-deploy.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "pnpm build && firebase emulators:start --only functions"
  },
  "dependencies": {
    "@jindu/shared": "workspace:*",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
