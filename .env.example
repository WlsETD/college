# ---------------------------------------------------------------
# 複製成 .env.local（apps/web）後填入實際值。.env* 已被 .gitignore 排除。
# 這個檔案只放佔位字串，任何真實金鑰都不得寫進版控。
# ---------------------------------------------------------------

# Firebase Web App 設定（Console → 專案設定 → 一般 → 您的應用程式）
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# App Check（Console → App Check → reCAPTCHA Enterprise 網站金鑰）
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=your-site-key
# 本機開發用的 debug token，由瀏覽器 console 產生後貼到 Console 註冊。
# 留空代表不啟用 debug 模式。
VITE_APPCHECK_DEBUG_TOKEN=

# 本機 Emulator：設為 true 時前端連到 localhost 的模擬器而非正式環境
VITE_USE_EMULATOR=true
